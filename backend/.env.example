# MongoDB Connection
#
# You can use either of these formats:
#
# 1) SRV connection string (mongodb+srv://)
# - Uses DNS SRV records: _mongodb._tcp.<cluster-host>
# - May fail on some networks due to DNS restrictions (querySrv failures)
# Format:
#   mongodb+srv://username:password@clusterHost/dbName?retryWrites=true&w=majority&appName=yourApp
MONGODB_URI=mongodb+srv://kaiuser:SIFRE@kafein-flow.z8rjcgn.mongodb.net/kafeinflow?retryWrites=true&w=majority&appName=kafein-flow
#
# 2) Standard connection string (mongodb://)
# - Does NOT require DNS SRV lookup
# - Use this if you see: querySrv ECONNREFUSED / ENOTFOUND / SERVFAIL / REFUSED
# Format:
#   mongodb://username:password@host1:27017,host2:27017,host3:27017/dbName?replicaSet=...&ssl=true&authSource=admin
# Example (replace hosts/replicaSet with your Atlas values):
# MONGODB_URI=mongodb://kaiuser:SIFRE@kafein-flow-shard-00-00.z8rjcgn.mongodb.net:27017,kafein-flow-shard-00-01.z8rjcgn.mongodb.net:27017,kafein-flow-shard-00-02.z8rjcgn.mongodb.net:27017/kafeinflow?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin&retryWrites=true&w=majority&appName=kafein-flow

# Server Port
PORT=5000

# Maximum number of port retry attempts if PORT is in use
MAX_PORT_TRIES=10

# Environment
NODE_ENV=development

# Google reCAPTCHA v3
# Get your keys from: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# CORS Configuration
# Comma-separated list of allowed origins for production
# Example: https://kai-flow.com,https://www.kai-flow.com,https://app.kai-flow.com
ALLOWED_ORIGINS=https://kai-flow.com,https://www.kai-flow.com
